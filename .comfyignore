# Files excluded from the archive published to the ComfyUI Registry.
# Uses .gitignore pattern syntax; layered on top of .gitignore.

# Test suite and its CI (not needed at runtime)
tests/
.github/
# pytest config; its testpaths point at the excluded tests/ directory
pytest.ini

# Local-only runtime and benchmark output
cache/
benchmark_results/

# Contributor / session notes, not user documentation
CLAUDE.md
HANDOFF.md
